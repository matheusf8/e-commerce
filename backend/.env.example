# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL (used to build Mercado Pago redirect back_urls)
FRONTEND_URL=http://localhost:5173

# This backend's own public URL (used for the Mercado Pago webhook notification_url).
# Leave as localhost in dev — Mercado Pago can't reach it there anyway. Set to the
# real https:// deploy URL in production so the webhook activates.
BACKEND_URL=http://localhost:8000

# Mercado Pago — use ONLY the sandbox/test Access Token (starts with TEST-),
# never the production one (starts with APP_USR-). See docs/PAGAMENTO_MERCADO_PAGO.md
MP_ACCESS_TOKEN=
# "Chave secreta" from the app's Webhooks config page on Mercado Pago — verifies
# webhook calls are really from Mercado Pago. Required in production, not usable locally.
MP_WEBHOOK_SECRET=

# Cloudinary (upload de imagem de produto) — pegue em cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email transacional: boas-vindas, confirmação de pedido, redefinir senha)
# Pegue a API key em resend.com/api-keys. Sem verificar domínio próprio, use o
# remetente de teste padrão deles (onboarding@resend.dev) — funciona out-of-the-box.
RESEND_API_KEY=
EMAIL_FROM=E-Shop <onboarding@resend.dev>

# Environment
ENVIRONMENT=development
DEBUG=True
