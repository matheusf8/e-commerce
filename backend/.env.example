# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL (used to build Mercado Pago redirect back_urls)
FRONTEND_URL=http://localhost:5173

# Mercado Pago — use ONLY the sandbox/test Access Token (starts with TEST-),
# never the production one (starts with APP_USR-). See docs/PAGAMENTO_MERCADO_PAGO.md
MP_ACCESS_TOKEN=

# Environment
ENVIRONMENT=development
DEBUG=True
