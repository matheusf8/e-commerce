# Frontend environment variables
VITE_API_URL=http://localhost:8000

# Identidade da loja — preencha com os dados reais do cliente antes de
# publicar (ver frontend/src/config/site.ts). Sem essas vars, o app cai nos
# defaults de demonstração ("E-Shop", email/telefone fake).
VITE_SITE_NAME=E-Shop
VITE_SITE_LEGAL_NAME=
VITE_SITE_TAGLINE=
VITE_SITE_EMAIL=contato@exemplo.com
VITE_SITE_PHONE=
VITE_SITE_ADDRESS=

# Selos de confiança na Home ("4.9 de 5 estrelas", "+10.000 clientes").
# Deixe vazio até o cliente ter métricas reais pra divulgar — preencher com
# número inventado é propaganda enganosa.
VITE_SITE_RATING=
VITE_SITE_CUSTOMER_COUNT=
